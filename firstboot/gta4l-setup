def zones():
    found = set()
    try:
        with open('/usr/share/zoneinfo/tzdata.zi') as f:
            for line in f:
                p = line.split()
                if len(p) > 1 and p[0] == 'Z':
                    found.add(p[1])
                elif len(p) > 2 and p[0] == 'L':
                    found.add(p[2])
    except OSError:
        pass
    skip = ('Etc/', 'SystemV/', 'posix', 'right', 'US/', 'Canada/', 'Brazil/', 'Chile/', 'Mexico/')
    out = {}
    for z in sorted(found):
        if '/' in z and not z.startswith(skip):
            region, city = z.split('/', 1)
            out.setdefault(region, []).append(city)
    return out or {'Europe': ['Istanbul'], 'UTC': ['UTC']}


def current_zone():
    try:
        return os.path.realpath('/etc/localtime').split('/zoneinfo/', 1)[1]
    except (IndexError, OSError):
        return 'Europe/Istanbul'


def read(path, default):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


def strength(pw):
    score = 0
    if len(pw) >= 6:
        score += 1
    if len(pw) >= 10:
        score += 1
    if re.search(r'[a-z]', pw) and re.search(r'[A-Z]', pw):
        score += 1
    if re.search(r'\d', pw) and re.search(r'[^A-Za-z0-9]', pw):
        score += 1
    return score


if '--first-boot' in sys.argv and os.path.exists(DONE):
