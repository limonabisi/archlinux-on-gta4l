    def on_password(self, *_):
        pw = self.password.get_text() if hasattr(self, 'password') else ''
        s = strength(pw) if pw else 0
        self.level.set_value(s)
        self.level_text.set_text('' if not pw else self.tr(['weak', 'weak', 'fair', 'good', 'strong'][s]))

    def show_step(self):
        name = STEPS[self.step]
        self.stack.set_visible_child_name(name)
        for i, lab in enumerate(self.step_labels):
            ctx = lab.get_style_context()
            for c in ('current', 'done'):
                ctx.remove_class(c)
            if i == self.step:
                ctx.add_class('current')
            elif i < self.step:
                ctx.add_class('done')
            lab.set_text(('✓  ' if i < self.step else '') + self.tr('s_' + STEPS[i]))
        self.back.set_visible(self.step > 0)
        last = self.step == len(STEPS) - 1
        self.texts = [(s, k) for s, k in self.texts if s != self.next.set_label]
        self.texts.append((self.next.set_label, 'apply' if last else 'next'))
        self.next.set_label(self.tr('apply' if last else 'next'))
        if name == 'summary':
            self.fill_summary()

    def validate(self):
        name = STEPS[self.step]
        if name == 'account':
            user = self.username.get_text().strip()
            pw, pw2 = self.password.get_text(), self.password2.get_text()
            if not USER_RE.match(user) or user in ('root', 'fastrpc'):
                return 'e_user'
            if not pw:
                return 'e_pw'
            if pw != pw2:
                return 'e_pw2'
            if pw == DEFAULT_PASSWORD:
                return 'e_1234'
        if name == 'tablet' and not HOST_RE.match(self.hostname.get_text().strip()):
            return 'e_host'
        return None

    def go(self, delta):
        self.error.set_text('')
        if delta > 0:
            err = self.validate()
            if err:
                self.error.set_text(self.tr(err))
                return
            if self.step == len(STEPS) - 1:
                return self.apply()
        self.step = max(0, min(len(STEPS) - 1, self.step + delta))
        self.show_step()

    def zone(self):
        return '%s/%s' % (self.region.get_active_id(), self.city.get_active_id())

    def fill_summary(self):
        for ch in self.sum_grid.get_children():
            self.sum_grid.remove(ch)
        user = self.username.get_text().strip()
        full = self.fullname.get_text().strip()
        rows = [
            ('sum_user', user + (' (%s)' % full if full else '')),
            ('sum_sudo', self.tr('sum_sudo_v')),
            ('sum_host', self.hostname.get_text().strip()),
            ('sum_zone', self.zone().replace('_', ' ')),
            ('sum_lang', self.lang_combo.get_active_text()),
            ('sum_kb', self.kb_combo.get_active_text()),
            ('sum_ssh', self.tr('on') if self.ssh.get_active() else self.tr('off')),
        ]
        for i, (k, v) in enumerate(rows):
            a = Gtk.Label(label=self.tr(k), xalign=0)
            a.get_style_context().add_class('sumkey')
            b = Gtk.Label(label=v, xalign=0, ellipsize=Pango.EllipsizeMode.END)
            b.get_style_context().add_class('sumval')
            self.sum_grid.attach(a, 0, i, 1, 1)
            self.sum_grid.attach(b, 1, i, 1, 1)
        self.sum_grid.show_all()
        old = os.environ.get('USER', 'alarm')
        self.sum_note.set_text(self.tr('sum_alarm') if old == 'alarm' and user != 'alarm' else '')

    def ask_current_password(self):
        d = Gtk.Dialog(title=self.tr('cur_pw_t'), transient_for=self, modal=True)
        d.add_buttons(self.tr('cancel'), Gtk.ResponseType.CANCEL, self.tr('ok'), Gtk.ResponseType.OK)
        area = d.get_content_area()
        area.set_spacing(12)
        area.set_border_width(24)
        area.add(Gtk.Label(label=self.tr('cur_pw')))
        e = Gtk.Entry(visibility=False, activates_default=True)
        area.add(e)
        d.set_default_response(Gtk.ResponseType.OK)
        d.show_all()
        ok = d.run() == Gtk.ResponseType.OK
        pw = e.get_text()
        d.destroy()
        return pw if ok else None

    def set_working(self, title, sub, spinning, done=False):
        self.stack.set_visible_child_name('working')
        self.work_title.set_text(title)
        self.work_sub.set_text(sub)
        self.spinner.set_visible(spinning)
        self.done_icon.set_visible(done)
        if spinning:
            self.spinner.start()
        else:
            self.spinner.stop()

    def apply(self):
        cfg = {
            'fullname': self.fullname.get_text().strip(),
            'user': self.username.get_text().strip(),
            'password': self.password.get_text(),
            'hostname': self.hostname.get_text().strip(),
            'zone': self.zone(), 'lang': self.lang_combo.get_active_id(),
            'layout': self.kb_combo.get_active_id(), 'ssh': self.ssh.get_active(),
            'old_user': os.environ.get('USER', 'alarm'),
        }
        for w in (self.back, self.next, self.later):
            w.set_sensitive(False)
        self.set_working(self.tr('working_t'), self.tr('working_s'), True)

        def work():
            rundir = os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir()
            fd, path = tempfile.mkstemp(prefix='gta4l-setup-', suffix='.json', dir=rundir)
            with os.fdopen(fd, 'w') as f:
                json.dump(cfg, f)
            r = subprocess.run(['sudo', '-S', '-p', '', '--', APPLY, path],
                               input=self.sudo_password + '\n', capture_output=True, text=True)
            if os.path.exists(path):
                os.remove(path)
            GLib.idle_add(self.applied, r)

        threading.Thread(target=work, daemon=True).start()

    def applied(self, r):
        err = (r.stderr or '').lower()
        if r.returncode != 0 and ('incorrect password' in err or 'try again' in err or 'password is required' in err):
            pw = self.ask_current_password()
            if pw is None:
                self.fail(self.tr('not_changed'))
                return False
            self.sudo_password = pw
            self.apply()
            return False
        if r.returncode != 0:
            self.fail((r.stderr.strip() or r.stdout.strip())[-400:])
            return False
        self.set_working(self.tr('done_t'), self.tr('done_s'), False, done=True)
        GLib.timeout_add_seconds(3, lambda: subprocess.run(['systemctl', 'reboot']) and False)
        return False

    def fail(self, text):
        self.set_working(self.tr('fail_t'), text, False)
        for w in (self.back, self.next, self.later):
            w.set_sensitive(True)
        self.step = len(STEPS) - 1
        self.back.set_visible(True)


